{
  "name": "rivver-backend",
  "version": "1.0.50",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile build/rivver-server src/index.ts",
    "worker:rss": "bun run src/worker/rss/index.ts",
    "worker:embedding": "bun run src/worker/embedding/index.ts",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/cron": "^1.4.1",
    "@elysiajs/openapi": "^1.4.14",
    "@xenova/transformers": "^2.17.2",
    "better-auth": "^1.3.7",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "1.0.0-beta.15-9485290",
    "drizzle-typebox": "^0.3.3",
    "elysia": "^1.4.27",
    "elysia-remote-dts": "^1.0.3",
    "postgres": "^3.4.8",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "bun-types": "^1.3.10",
    "drizzle-kit": "1.0.0-beta.15-9485290"
  },
  "module": "src/index.js"
}
